{
  "name": "telegram-group-lists",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "deploy": "npm run typecheck && npm run test && npm run build && wrangler deploy --keep-vars",
    "db:local": "wrangler d1 migrations apply telegram-list-bot --local",
    "db:remote": "wrangler d1 migrations apply telegram-list-bot --remote",
    "telegram:setup": "node scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1",
    "miniflare": "5.20261012.1-beta"
  }
}
