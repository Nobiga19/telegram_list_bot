{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-list-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/telegram/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-list-bot",
      "database_id": "e8458b1a-60d1-4e97-80c6-16e064e4e111",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://telegram-list-bot.gabino-ro-dom.workers.dev",
    "BOT_USERNAME": "ourizo_telegram_list_bot",
    "PIN_MESSAGES": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
